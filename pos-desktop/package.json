{
  "name": "adena-pos-desktop",
  "version": "1.3.0",
  "description": "Adena POS ver 1.3 offline-first (Electron + SQLite)",
  "main": "src/main/main.js",
  "author": "Adena",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "lint": "echo 'No lint config yet'"
  },
  "build": {
    "appId": "com.adena.posdesktop",
    "productName": "Adena POS ver 1.3",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/logs{,/**}",
      "!**/cache{,/**}",
      "!**/tmp{,/**}",
      "!**/temp{,/**}",
      "!**/*.log",
      "!**/*.bak",
      "!**/*.backup",
      "!**/test{,/**}",
      "!**/tests{,/**}",
      "!**/__tests__{,/**}"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "asar": true,
    "compression": "maximum",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ]
  },
  "dependencies": {
    "axios": "^1.8.4",
    "better-sqlite3": "^11.9.1",
    "electron-store": "8.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12"
  }
}
