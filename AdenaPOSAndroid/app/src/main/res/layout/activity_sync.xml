<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F172A">
  <LinearLayout android:layout_width="620dp" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal" android:padding="34dp" android:background="#FFFFFF">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adena POS" android:textStyle="bold" android:textSize="31sp" android:textColor="#0F172A" />
    <TextView android:id="@+id/syncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Menunggu sinkronisasi..." android:textSize="18sp" android:textColor="#334155" />
    <ProgressBar android:id="@+id/syncProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginTop="24dp" android:max="100" />
    <TextView android:id="@+id/syncDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textSize="14sp" android:textColor="#64748B" />
    <Button android:id="@+id/continueOfflineButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Masuk POS" android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
